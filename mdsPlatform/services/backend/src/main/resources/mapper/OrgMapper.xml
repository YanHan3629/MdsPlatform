<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.fwdrobo.sirius.mapper.OrgMapper">

    <resultMap id="OrgMap" type="com.fwdrobo.sirius.entity.permission.Org">
        <id column="org_id" property="orgId" javaType="java.util.UUID"/>
        <result column="org_name" property="orgName"/>
        <result column="org_status" property="orgStatus" javaType="java.lang.Integer"/>
        <result column="license_type" property="licenseType"/>
        <result column="created_at" property="createdAt" javaType="java.time.OffsetDateTime"/>
        <result column="created_by" property="createdBy" javaType="java.util.UUID"/>
        <result column="updated_at" property="updatedAt" javaType="java.time.OffsetDateTime"/>
        <result column="updated_by" property="updatedBy" javaType="java.util.UUID"/>
    </resultMap>

    <sql id="BaseColumns">
        org_id, org_name, org_status, license_type, created_at, created_by, updated_at, updated_by
    </sql>


    <select id="selectById" resultMap="OrgMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM org
        WHERE org_id = #{orgId}
    </select>

    <select id="selectByName" resultMap="OrgMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM org
        WHERE org_name = #{orgName}
    </select>

    <select id="selectLicenseTypeByOrgId" resultType="java.lang.String">
        SELECT license_type
        FROM org
        WHERE org_id = #{orgId}
    </select>

    <select id="selectAll" resultMap="OrgMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM org
        <where>
            <if test="orgStatus != null">
                org_status = #{orgStatus}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <select id="countByStatus" resultType="long">
        SELECT COUNT(*)
        FROM org
        <where>
            <if test="orgStatus != null">
                org_status = #{orgStatus}
            </if>
        </where>
    </select>

    <select id="selectPageByStatus" resultMap="OrgMap">
        SELECT
        <include refid="BaseColumns"/>
        FROM org
        <where>
            <if test="orgStatus != null">
                org_status = #{orgStatus}
            </if>
        </where>
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="insert" resultType="java.util.UUID">
        INSERT INTO org (org_id, org_name, org_status, license_type, created_at, created_by)
        VALUES (COALESCE(#{orgId}, gen_random_uuid()),
                #{orgName},
                COALESCE(#{orgStatus}, 1),
                COALESCE(#{licenseType}, 'FORMAL'),
                #{createdAt},
                #{createdBy})
        RETURNING org_id
    </select>

    <update id="update">
        UPDATE org
        SET
            org_name = COALESCE(#{orgName}, org_name),
            org_status = COALESCE(#{orgStatus}, org_status),
            license_type = COALESCE(#{licenseType}, license_type),
            updated_at = COALESCE(#{updatedAt}, updated_at),
            updated_by = COALESCE(#{updatedBy}, updated_by)
        WHERE org_id = #{orgId}
    </update>

    <delete id="deleteById">
        DELETE FROM org WHERE org_id = #{orgId}
    </delete>

</mapper>
