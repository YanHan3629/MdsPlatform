<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fwdrobo.sirius.mapper.MmSpaceMapper">
    <resultMap id="MmSpaceMap" type="com.fwdrobo.sirius.entity.mm.MmSpace">
        <id column="space_id" property="spaceId" javaType="java.util.UUID"/>
        <result column="space_name" property="spaceName"/>
        <result column="description" property="description"/>
        <result column="org_id" property="orgId" javaType="java.util.UUID"/>
        <result column="owner_user_id" property="ownerUserId" javaType="java.util.UUID"/>
        <result column="visibility" property="visibility"/>
        <result column="status" property="status"/>
        <result column="meta" property="meta" typeHandler="com.fwdrobo.sirius.handler.JsonbTypeHandler"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
    <insert id="insert" parameterType="com.fwdrobo.sirius.entity.mm.MmSpace">
        INSERT INTO public.mm_space (
            space_id, space_name, description, org_id, owner_user_id, visibility, status, meta
        ) VALUES (
            #{spaceId}, #{spaceName}, #{description}, #{orgId}, #{ownerUserId}, #{visibility}, #{status},
            #{meta, typeHandler=com.fwdrobo.sirius.handler.JsonbTypeHandler}
        )
    </insert>
    <select id="selectById" resultMap="MmSpaceMap">
        SELECT * FROM public.mm_space WHERE space_id = #{spaceId}
    </select>
    <select id="selectByOrgIdAndName" resultMap="MmSpaceMap">
        SELECT * FROM public.mm_space WHERE org_id = #{orgId} AND space_name = #{spaceName}
    </select>
    <select id="selectByOrgId" resultMap="MmSpaceMap">
        SELECT * FROM public.mm_space WHERE org_id = #{orgId} ORDER BY created_at DESC LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="countByOrgId" resultType="long">
        SELECT COUNT(*) FROM public.mm_space WHERE org_id = #{orgId}
    </select>
</mapper>
